<UserControl x:Class="CnSharp.VSIX.Yolo.YoloOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CnSharp.VSIX.Yolo"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="720"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">

    <UserControl.Resources>
        <local:BoolToInstalledBrushConverter x:Key="InstalledBrush"/>
        <local:AgentIconConverter x:Key="AgentIcon"/>
        <local:AgentIconInstalledConverter x:Key="AgentIconInstalled"/>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Agents grid -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                <DataGrid x:Name="AgentsGrid"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      BeginningEdit="AgentsGrid_BeginningEdit"
                      SelectionChanged="AgentsGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                            <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static local:Resources.Settings_Col_Icon}" Width="48" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource AgentIconInstalled}">
                                            <Binding Path="IconPath"/>
                                            <Binding Path="IsInstalled"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_Id}" Width="90" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_DisplayName}" Width="120" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_Command}" Width="120" Binding="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_BaseArgs}" Width="120" Binding="{Binding BaseArgs, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_SkipFlag}" Width="200" Binding="{Binding SkipFlag, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_ResumeFlag}" Width="120" Binding="{Binding ResumeFlag, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="{x:Static local:Resources.Settings_Col_IconPath}" Width="240" Binding="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- General options -->
        <CheckBox Grid.Row="1" x:Name="SuppressSkipWarningBox" Margin="0,8,0,0"
                  Content="{x:Static local:Resources.Settings_SuppressSkipWarning}"
                  Checked="SuppressSkipWarningBox_Changed" Unchecked="SuppressSkipWarningBox_Changed"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="{x:Static local:Resources.Settings_AddCustomTool}" Width="120" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="{x:Static local:Resources.Settings_RemoveSelected}" Width="120" Margin="8,0,0,0" Click="RemoveButton_Click"/>
            <Button x:Name="ValidateButton" Content="{x:Static local:Resources.Settings_Validate}" Width="90" Margin="8,0,0,0" Click="ValidateButton_Click"/>
        </StackPanel>

        <!-- Icon chooser for the selected custom tool -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Label Content="{x:Static local:Resources.Settings_IconForSelectedTool}" VerticalAlignment="Center"/>
            <TextBox x:Name="IconPathBox" Width="320" VerticalAlignment="Center" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Content="{x:Static local:Resources.Settings_Browse}" Width="80" Margin="8,0,0,0" Click="BrowseButton_Click"/>
            <Image x:Name="IconPreview" Width="20" Height="20" Margin="8,0,0,0"
                   VerticalAlignment="Center" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
