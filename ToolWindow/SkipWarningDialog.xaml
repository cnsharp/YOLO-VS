<Window x:Class="CnSharp.VSIX.Yolo.SkipWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CnSharp.VSIX.Yolo"
        Title="{x:Static local:Constants.ProductName}"
        Width="460" SizeToContent="Height" MinWidth="420"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="{x:Static local:Resources.Panel_SkipWarningText}"/>
        <CheckBox Grid.Row="1" x:Name="SuppressBox" Margin="0,12,0,0"
                  Content="{x:Static local:Resources.Panel_DontShowAgain}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
