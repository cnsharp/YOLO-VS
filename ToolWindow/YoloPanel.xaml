<UserControl x:Class="CnSharp.VSIX.Yolo.YoloPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CnSharp.VSIX.Yolo"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:interop="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="480"
             Background="{DynamicResource PanelBg}"
             Foreground="{DynamicResource PanelFg}">

    <UserControl.Resources>
        <!-- Brushes driven by the active VS theme (see YoloPanel.ApplyVsTheme). The defaults
             match the legacy dark theme so the panel never renders unstyled before theming runs. -->
        <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
        <SolidColorBrush x:Key="PanelFg" Color="#cccccc"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#3e3e42"/>
        <SolidColorBrush x:Key="ToolbarBg" Color="#2d2d2d"/>
        <SolidColorBrush x:Key="ComboBg" Color="#3c3c3c"/>
        <SolidColorBrush x:Key="ComboFg" Color="#cccccc"/>
        <SolidColorBrush x:Key="TabBg" Color="#2d2d2d"/>
        <!-- Active / inactive terminal-tab chrome, driven by the VS theme in ApplyVsTheme.
             Defaults match the legacy dark theme; the white active-tab background that the
             stock TabItem template forces is replaced by TabActiveBg (see the TabItem style). -->
        <SolidColorBrush x:Key="TabActiveBg" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="TabInactiveBg" Color="#2d2d2d"/>
        <SolidColorBrush x:Key="TabFgActive" Color="#f1f1f1"/>
        <SolidColorBrush x:Key="TabFgInactive" Color="#9b9b9b"/>
        <SolidColorBrush x:Key="TabAccent" Color="#007acc"/>

        <!-- WPF's stock ComboBox template (Aero2) paints the collapsed selection box from a
             hard-coded light resource (ComboBox.Static.Background), ignoring the Background we
             set — so it renders white in the dark theme. This template rebuilds the closed box
             to honour ComboBg/ComboFg/PanelBorder; the drop-down popup keeps using the themed
             SystemColors.* keys that ApplyVsTheme() re-points. -->
        <Style x:Key="DarkAgentComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboFg}"/>
            <Setter Property="Background" Value="{DynamicResource ComboBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Data="M0,0 L4,4 L8,0 Z"
                                                  Fill="{DynamicResource ComboFg}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionContent"
                                              Margin="7,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, ElementName=MainBorder}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Control panel: agent dropdown + Y/R toggles + actions, all on one row -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="AgentComboBox"
                          Width="160"
                          Style="{StaticResource DarkAgentComboBox}"
                          Background="{DynamicResource ComboBg}"
                          Foreground="{DynamicResource ComboFg}"
                          BorderBrush="{DynamicResource PanelBorder}"
                          FontSize="13"
                          SelectionChanged="OnAgentSelected">
                    <ComboBox.Resources>
                        <!-- WPF draws the drop-down popup (its border AND the item rows) from
                             SystemColors, which stay light in a dark theme no matter what
                             Background is set on the ComboBox itself. Overriding these keys
                             here scopes a dark popup to just this ComboBox; ApplyVsTheme()
                             swaps them for the live VS theme colours. -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#3c3c3c"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#cccccc"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#094771"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ffffff"/>
                    </ComboBox.Resources>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="16" Height="16"
                                       Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ComboFg}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="RunAgentButton"
                        Content="{x:Static local:Resources.Panel_Launch}"
                        Width="100" Height="24"
                        Margin="8,0,0,0"
                        Background="#0e639c"
                        Foreground="#ffffff"
                        BorderThickness="0"
                        FontSize="12"
                        Click="OnRunAgentClicked"/>

                <ToggleButton x:Name="YToggle"
                              Width="26" Height="26"
                              Margin="8,0,0,0"
                              Background="Transparent"
                              BorderBrush="#3e3e42"
                              BorderThickness="1"
                              ToolTip="{x:Static local:Resources.Panel_SkipTooltip}"
                              Checked="OnYToggleChecked"
                              Unchecked="OnYToggleUnchecked">
                    <Path x:Name="YIcon"
                          Data="M4.4,4.6 L7.6,12 M11.6,4.6 L6.2,14.6"
                          Stroke="#6C707E" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="16" Height="16"/>
                </ToggleButton>

                <ToggleButton x:Name="RToggle"
                              Width="26" Height="26"
                              Margin="6,0,0,0"
                              Background="Transparent"
                              BorderBrush="#3e3e42"
                              BorderThickness="1"
                              ToolTip="{x:Static local:Resources.Panel_ResumeTooltip}"
                              Checked="OnRToggleChecked"
                              Unchecked="OnRToggleUnchecked">
                    <Path x:Name="RIcon"
                          Data="M4.5,13 L4.5,3 L9,3 C11,3 11.6,4.4 11.6,6 C11.6,7.4 10.7,8 9,8 L4.5,8 M6.9,8 L11.5,13"
                          Stroke="#6C707E" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="16" Height="16"/>
                </ToggleButton>

                <Button x:Name="SettingsButton"
                        Width="26" Height="26"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderBrush="#3e3e42"
                        BorderThickness="1"
                        ToolTip="{x:Static local:Resources.Panel_SettingsTooltip}"
                        Click="OnSettingsClicked">
                    <imaging:CrispImage Width="16" Height="16" Moniker="{x:Static interop:KnownMonikers.Settings}" IsHitTestVisible="False"/>
                </Button>
                </WrapPanel>

                <!-- Right-aligned tab switcher: a compact chevron button (no text) that opens a
                     tab-list popup. Only shown when more than one terminal tab is open. -->
                <ToggleButton x:Name="TabSwitchButton"
                              Grid.Column="1"
                              Width="24" Height="24"
                              Margin="8,0,0,0"
                              Visibility="Collapsed"
                              Background="Transparent"
                              BorderBrush="{DynamicResource PanelBorder}"
                              BorderThickness="1"
                              ToolTip="{x:Static local:Resources.Panel_TabSwitchTooltip}"
                              Checked="OnTabSwitchOpened">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Path Data="M0,0 L5,5 L10,0 Z"
                                      Stretch="Uniform"
                                      Width="10" Height="6"
                                      Fill="{DynamicResource PanelFg}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup x:Name="TabSwitchPopup"
                       PlacementTarget="{Binding ElementName=TabSwitchButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       IsOpen="{Binding IsChecked, ElementName=TabSwitchButton, Mode=OneWay}"
                       Closed="OnTabSwitchPopupClosed"
                       AllowsTransparency="True"
                       PopupAnimation="Slide">
                    <Border Background="{DynamicResource ComboBg}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1"
                            MinWidth="160">
                        <ListBox x:Name="TabSwitchList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource ComboFg}"
                                 SelectionChanged="OnTabSwitchSelected"
                                 KeyboardNavigation.TabNavigation="Once">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ComboFg}"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TabInactiveBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TabActiveBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TabFgActive}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Every tab row shows its agent (or generic terminal) icon,
                                             so the popup reads like IDEA's own switcher instead of a
                                             checkmark that only appears on the active row. -->
                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               Margin="2,0,2,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Padding="2,4"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Multi-tab terminal: one tab per agent session (or plain shell) -->
        <TabControl Grid.Row="1"
                    x:Name="SessionTabs"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="0">
            <TabControl.Resources>
                <!-- The stock Aero2 TabItem template paints the SELECTED tab white and ignores our
                     Background setter, so the active tab's title was white-on-white in the dark theme.
                     This template honours TabActiveBg / TabInactiveBg / TabFgActive / TabFgInactive
                     (set per VS theme in ApplyVsTheme) for both states, and an accent underline. -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TabFgInactive}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="0,0,1,0"
                                        Margin="0">
                                    <ContentPresenter x:Name="Cp"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabInactiveBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TabFgActive}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabActiveBg}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabAccent}"/>
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TabFgActive}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
        </TabControl>

    </Grid>
</UserControl>
